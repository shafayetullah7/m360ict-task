PORT=4000

# Local run (pnpm dev on host + Docker Postgres only):
#   DB_HOST=localhost
#   DB_PORT=5444
#
# docker compose up (app service overrides DB_HOST/DB_PORT to postgres:5432)

DB_HOST=localhost
DB_PORT=5444
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=express_ts_db
DB_POOL_MIN=2
DB_POOL_MAX=10

JWT_SECRET=your_jwt_secret_min_32_chars_long
JWT_EXPIRES_IN=8h
UPLOAD_PATH=./uploads
